				(color 162 22 34 1)
			)
		)
		(uuid "e22af375-1576-4efc-a183-3ce51a0cca7e")
	)
	(text_box "DESIGN NOTE:\nLMR16006 enables its output when the SHDN pin voltage rises above 1.25V. By creating a divider from VIN to GND, we can program this threshold to occur when VIN reaches arround 4.5V.\nUVLO = 1.25 / divider ratio= 1.25 / 0.274 = 4.56V\nTherefore, the buck regulator will only turn on once @{\"Id\":\"WAERGTV~{P}XQEZMCJB\",\"ObjectType\":1} has reached 4.56V. To add a delay between the connection of the USB cable and the generation of 3v3, we can add a capacitor.\nFrom Thevenin equivalent resistance:\nRC = 27k x 1uF = 27ms\n\nV(t) = Vfinal x (1-e^(-t/RC))\n1.25= 1.37 x  (1-e^(-t/RC))\n-t/RC = ln(0.087)\nt = 2.44 x RC = 66ms\nLMR16006 should turn on 66ms after VBUS has reached 5V."
		(exclude_from_sim no)
		(at 116.84 83.185 0)
		(size 57.15 50.8)
		(margins 2 2 2 2)
		(stroke
			(width 1)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.397 1.397)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "29319df5-addf-4df6-b400-e4a5dd649d11")
	)
	(text_box "DESIGN NOTE:\nFB: Vout = 0.765 x (1 + Rtop/Rbot)\n= 0.765 x (1 + (33k / 10k) = 2.29V\n\nOptimized for 600mA:\nInductor: (48-3.3)x3.3 / (700000 x 48 x 0.18) = 24uH\n22uH was selected as a close standard value."
		(exclude_from_sim no)
		(at 295.91 114.3 0)
		(size 52.07 19.685)
		(margins 2 2 2 2)
		(stroke
			(width 1)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.397 1.397)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "83e7f809-abfa-4272-a40d-0791046b4b87")
	)
	(text_box "DESIGN NOTE:\nLED current: (17 - 2.65) / 10000 = 1.4mA"
		(exclude_from_sim no)
		(at 307.975 140.335 0)
		(size 40.005 7.62)
		(margins 2 2 2 2)
