			)
			(justify left top)
		)
		(uuid "97aa4ff0-28ae-45f8-8d60-a3bbd7784e29")
	)
	(text_box "DESIGN NOTE:\nFB: Vout = 0.765 x (1 + Rtop/Rbot)\n= 0.765 x (1 + (200k / 9.4k) = 17.04V\n\nOptimized for 600mA:\nInductor: (48-17)x17 / (700000 x 48 x 0.18) = 87uH\n68uH was selected as a close standard value."
		(exclude_from_sim no)
