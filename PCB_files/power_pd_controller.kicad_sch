	(text_box "LAYOUT NOTE:\nCC1/CC2 capacitors need to be placed as close as possible to their respective pins and on the same layer as the TPS26750 device.\n\n\n"
		(exclude_from_sim no)
		(at 96.52 154.305 0)
		(size 35.56 14.605)
		(margins 2.25 2.25 2.25 2.25)
		(stroke
			(width 0.762)
