		(uuid "198fea2f-1b44-475c-8259-f028ae7ae2d5")
	)
	(text_box "DESIGN NOTE:\nTPD4S480 have only 4uA of sourcing curent at EPR_BLK_G. BZT52C18SQ have a maximum leakage current of 0.1uA.\nWorst case sinking current: (21.17V - 17.1) / 33000 = 123 uA\nTurn-on time = 10nF x 12V /  4uA = 12ms\n"
		(exclude_from_sim no)
		(at 140.335 121.285 0)
		(size 62.865 15.875)
		(margins 2 2 2 2)
